	{
		trigger self tracks_forward
		
		accum 1 bitset 2
		followspline 0 path_59 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger barricade0_constructed
	{
		accum 1 bitset 0
	}
	trigger barricade0_destroyed
	{
		accum 1 bitreset 0
	}
	
	trigger barricade1_constructed
	{
		accum 1 bitset 1
	}
	trigger barricade1_destroyed
	{
		accum 1 bitreset 1
	}

// ===========================================================================================
// stuck checking
// digibob: since we cant return variables, just use bit 3 of accum 1 as a register... mmmm assembly...
	trigger stuck_check
	{
		accum 1 bitreset 3

		trigger self stuck_check_barrier0_built
		trigger self stuck_check_barrier1_built
		trigger self stuck_check_scriptlockout
		trigger self stuck_check_finished
	}

	trigger stuck_check_finished
	{
		accum 3 abort_if_less_than 59

		accum 1 bitset 3
	}

	trigger stuck_check_scriptlockout
	{
		accum 5 abort_if_equal 0

		accum 1 bitset 3
	}

	trigger stuck_check_barrier0_built
	{
		accum 3 abort_if_not_equal 35

		accum 1 abort_if_not_bitset 0

		accum 1 bitset 3
	}
	
	trigger stuck_check_barrier0_built_msg
	{
		accum 1 abort_if_not_bitset 0

		// *----------------------------------- vo ------------------------------------------*
		wm_teamvoiceannounce 1 "goldrush_allies_tankbars_destroy"
		// *---------------------------------------------------------------------------------*
	}

	trigger stuck_check_barrier1_built
	{
		accum 3 abort_if_not_equal 48

		accum 1 abort_if_not_bitset 1

		accum 1 bitset 3
	}

	trigger stuck_check_barrier1_built_msg
	{
		accum 1 abort_if_not_bitset 1

		// *----------------------------------- vo ------------------------------------------*
		wm_teamvoiceannounce 1 "goldrush_allies_tankbar_destroy"
		// *---------------------------------------------------------------------------------*
	}

// ===========================================================================================
// stop check

	trigger stopcheck_setup
	{
		accum 1 bitset 6			// stop if we're stuck/no-one's pushing :)

		accum 1 abort_if_bitset 8		// no one in the trigger, abort

		trigger self stuck_check		// call the stop check function
		accum 1 abort_if_bitset 3		// we're stuck so break out

		accum 1 bitreset 6			// we're free to move
	}

	trigger stopcheck
	{
		trigger self stopcheck_setup
		accum 1 abort_if_not_bitset 6

		trigger self script_lockout

		// Any just stopped moving stuff goes here
		trigger tank_sound 	stop
		trigger self 		tracks_stop
		startanimation 45 	10 	15 nolerp norandom
		wait 666
		startanimation 0 	1 	15 nolerp norandom
		wait 900

		trigger self script_lockout_stop
		resetscript
	}

// ===========================================================================================
// ===========================================================================================
// script lockouts

	trigger script_lockout
	{
		accum 5 inc 1
	}

	trigger script_lockout_stop
	{
		accum 5 inc -1
	}

// ===========================================================================================
// ===========================================================================================
// enable/disable

	trigger tank_enable
	{
		trigger self stuck_check
		accum 1 abort_if_bitset 3 	// stuck check

		accum 4 set 0				// reset stop counter
		accum 1 bitreset 8			// reset stop check

		accum 1 abort_if_bitset 2 	// already following spline
		accum 5 abort_if_not_equal 0	// are we not in a script lockout?

		accum 1 abort_if_bitset 7 	// death check

		// Any just started moving stuff goes here

		trigger self script_lockout

		trigger tank_sound start

		startanimation 55 10 15 nolerp norandom
		wait 666
		startanimation 5 40 15 nolerp norandom
		wait 500
		trigger self tracks_forward

		trigger self script_lockout_stop

		trigger self move
	}

	trigger tank_disable
	{
		accum 4 inc 1				// up the stop counter
		accum 4 abort_if_less_than 4

		accum 1 bitset 8			// set stop check

		trigger self deathcheck
	}

// ===========================================================================================
// ===========================================================================================
// death / rebirth

	rebirth
	{
		accum 1 bitreset 9 // we're visibly alive
		accum 1 bitreset 7 // we're alive again

		trigger self script_lockout

		changemodel models/mapobjects/tanks_sd/jagdpanther_africa_tracks.md3

		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "axis_hq_tank_stop"
///		wm_addteamvoiceannounce 0 "axis_hq_tank_damaged"

		wm_teamvoiceannounce 0 "axis_hq_tank_repaired_allies"
		wm_teamvoiceannounce 1 "allies_hq_tank_repaired"

///		wm_removeteamvoiceannounce 0 "axis_hq_tank_damaged"
		wm_removeteamvoiceannounce 1 "allies_hq_tank_damaged_axis"
		// *---------------------------------------------------------------------------------*

		trigger tank_sound rebirth
		wait 500

		trigger self script_lockout_stop
	}

	death
	{
		accum 1 bitset 7
	}

	trigger deathcheck
	{
		accum 1 abort_if_not_bitset 7	// are we dead?
		accum 1 abort_if_bitset 9		// are we not already visibly dead?
		accum 1 abort_if_bitset 2		// are we not following a spline?
		accum 5 abort_if_not_equal 0	// are we not in a script lockout?

		accum 1 bitset 9				// we're now visibly dead

		trigger self deathcheck_message
		accum 1 bitset 4

		changemodel models/mapobjects/tanks_sd/jagdpanther_africa_tracks2.md3

		kill tank_construct

		trigger self sound_death
		trigger self tracks_stop

		trigger self script_lockout

		trigger self tracks_stop
		startanimation 45 10 15 nolerp norandom
		wait 666
		startanimation 0 1 15 nolerp norandom

		trigger self script_lockout_stop

		resetscript
	}

	trigger deathcheck_message
	{
		accum 1 abort_if_not_bitset 4

		wm_announce "^oThe Tank has been damaged!"

		// *----------------------------------- vo ------------------------------------------*
///		wm_addteamvoiceannounce 0 "axis_hq_tank_damaged"
		wm_addteamvoiceannounce 1 "allies_hq_tank_damaged_axis"

		wm_teamvoiceannounce 0 "axis_hq_tank_damaged"
		wm_teamvoiceannounce 1 "allies_hq_tank_damaged_axis"

		wm_removeteamvoiceannounce 0 "axis_hq_tank_stop"
///		wm_removeteamvoiceannounce 0 "axis_hq_tank_damaged"
		wm_removeteamvoiceannounce 1 "allies_hq_tank_damaged_axis"
		// *---------------------------------------------------------------------------------*
	}

	trigger startfire
	{
		startanimation 67 8 10 nolerp norandom noloop
	}

	trigger stopfire
	{
		startanimation 0 1 15 nolerp norandom
	}

	trigger enable_stage2
	{
		accum 1 bitreset 0
	}

	trigger disable_stage2
	{
		accum 1 bitset 0
	}

	trigger enable_stage4
	{
		accum 1 bitreset 1
	}

	trigger disable_stage4
	{
		accum 1 bitset 1
	}
}

tank_trigger
{
	spawn
	{
		wait 500

		attachtotag tank_shell tag_turret

		trigger tank_trigger bot_goal_loop
	}

	trigger bot_goal_loop
	{
		wait 4000	// check every 4 seconds
		trigger tank bot_active_check
		trigger tank_trigger bot_goal_loop
	}
}

tank_build
{
	spawn
	{
		wait 500
		setstate tank_build invisible
		attachtotag tank_shell tag_turret
	}
}

tank_construct
{
	spawn
	{
		wait 1000

		kill tank

		constructible_class 2
		constructible_health 1200
		constructible_constructxpbonus 10
		constructible_destructxpbonus 10
	}

	built final
	{
		alertentity tank

		wm_announce "^oThe Tank has been repaired!"
	}
}

tank_shell
{
	spawn
	{
		wait 400
		attachtotag tank tag_tank
	}
}

tank_turret
{
	spawn
	{
		wait 500

		attachtotag tank_shell tag_turret
	}

	trigger turn
	{
		wait 1000

		playsound sound/vehicles/tank/turret_spin.wav looping
		faceangles 0 320 0 3000
		stopsound
		playsound sound/vehicles/tank/turret_end.wav

		wait 500

		trigger tank startfire
		playsound sound/vehicles/tank/tank_fire.wav
		trigger boomtrigger boom_all		// triggers the hurts around bank explosions (each has its own wait for timing)
		trigger tank_flash run
	}

	trigger blow_doors
	{
		setstate tank_flash invisible

		wait 200
		trigger tank stopfire

		alertentity bank_door1
		setstate doorframe_damaged default

		wait 100

		playsound sound/vehicles/tank/turret_spin.wav looping
		faceangles 0 0 0 3000
		stopsound
		playsound sound/vehicles/tank/turret_end.wav
		trigger tank sound_death
		trigger tank script_lockout_stop
		
		wm_announce "^oAllied team has destroyed the Temple Door!"
		wm_teamvoiceannounce 0 "radar_axis_entrance1_destroyed"
		wm_teamvoiceannounce 1 "radar_allies_entrance1_destroyed"
		
		wm_objective_status		3 0 2
		wm_objective_status		3 1 1		
		
		trigger tank_end time
		
		remapshader "sprites/objective" "textures/oasi/objective_key"
		remapshaderflush	
	}
}

tank_flash
{
	spawn
	{
		setstate tank_flash invisible
	}

	trigger run
	{
		setstate tank_flash default
 		attachtotag tank_turret tag_flash
		faceangles 0 90 0 50

		wait 50

		trigger tank_turret blow_doors
	}
}

tank_disabler
{
	trigger run
	{
		trigger tank tank_disable
	}
}

tank_enabler
{
	trigger run
	{
		trigger tank tank_enable
	}
}

tank_smoke
{
	spawn
	{
		wait 300
		attachtotag tank_shell tag_smoke
		setstate tank_smoke invisible
	}
}

tank_end
{
	spawn
	{
	}
	
	trigger time
	{
		trigger keydoor_left door_flip
		trigger keydoor_right door_flip
		
		wait 500
		wm_announce "^o+4 min Timebonus"
 		cvar timelimit inc "1"
 		cvar timelimit inc "1"
 		cvar timelimit inc "1"
 		cvar timelimit inc "1"
		
		wm_teamvoiceannounce 0 "axisprotectkey"
		wm_teamvoiceannounce 1 "alliesstealkey"
		wait 500
		wm_removeteamvoiceannounce 0 "axis_hq_tank_stop"
		wm_removeteamvoiceannounce 0 "axisprotectkey"
		wm_removeteamvoiceannounce 1 "alliesstealkey"
		
		togglespeaker war3
	}	
}

/// *************************************************
/// ********* KEY DOOR FLIP ***********
/// *************************************************
keydoor_right
{
	spawn
	{
	}
	
	trigger door_flip
	{
		wait 650
		faceangles 0 1 -285 650
	}
}

keydoor_left
{
	spawn
	{
	}
	
	trigger door_flip
	{
		wait 500
		
		playsound sound/world/metalbreak.wav
		
		wait 100
		faceangles 0 -2 -281 600
	}
}

/// *************************************************
/// ********* FIRST TANK GATE ***********
/// *************************************************
gate_right
{
	spawn
	{
	}
	
	trigger gate_flip
	{
		wait 650
		faceangles -270 1 0 650
	}
}

gate_left
{
	spawn
	{
	}
	
	trigger gate_flip
	{
		wait 500
		
		playsound sound/world/metalbreak.wav
		
		wait 100
		faceangles -270 -2 0 600

  		setautospawn "Garage Spawn" 1
		setautospawn "Cave Spawn" 0
		
		setstate allied_first_spawns_wobj invisible
		setstate allied_old_city_spawns_wobj invisible
///		setstate allied_city2_spawns_wobj invisible
		setstate allied_garage_spawns_wobj default
		setstate axis_old_city_spawns_wobj invisible		
		setstate axis_garage_spawns_wobj invisible
		setstate axis_cave_spawns_wobj default
		
		setstate allied_first_spawns invisible
		setstate allied_city_spawns invisible
		setstate allied_city2_spawns invisible		
		setstate allied_garage_spawns default
		setstate axis_city_spawns invisible		
		setstate axis_garage_spawns invisible
		setstate axis_cave_spawns default

		trigger city2flag force_allied  ///// Switch forward spawn to Allied ONLY
		trigger city2flag check_obj		
		trigger city2flag kill

		wait 3000
		wm_announce "^oThe Tank has entered the Oasi Tunnel."

		wm_teamvoiceannounce 0 "fueldump_axis_tank_tunnel"

		wait 1000
		// Message to alert players
		wm_announce "^oAllies have secured the City."
		wm_teamvoiceannounce 1 "allies_citysecure"
	}
}

// ************************************
// ******* AXIS DOOR EXPLOSION ********
// ************************************
boomtrigger
{
	trigger boom_all		// this is called from the tank to trigger all hurts
	{
		trigger hurt_barrelblast1 boom
		trigger hurt_bankblast boom
	}
}

hurt_barrelblast1
{
	spawn
	{
		wait 200
		setstate hurt_barrelblast1 invisible
	}

	trigger boom
	{
		setstate hurt_barrelblast1 default
		wait 100
		remove
	}
}

hurt_bankblast
