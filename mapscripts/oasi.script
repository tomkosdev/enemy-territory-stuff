		setautospawn "Temple" 0
		setstate temple_marker invisible
		setstate temple_spawn invisible
		setstate afp_marker invisible

		wm_setwinner 0
		wm_set_round_timelimit 30
		wm_number_of_objectives 8       // Map objectives
		// 1: Main Gate
		// 2: Fuel to tank
		// 3: Tank to temple
		// 4: Barriers
		// 5: Key
		// 6: Generator
		// 7: Flag
		// 8: Side entrance		

		wm_objective_status 1 0 0
		wm_objective_status 1 1 0
		wm_objective_status 2 0 0
		wm_objective_status 2 1 0
		wm_objective_status 3 0 0
		wm_objective_status 3 1 0
		wm_objective_status 4 0 0
		wm_objective_status 4 1 0
		wm_objective_status 5 0 0
		wm_objective_status 5 1 0	
		wm_objective_status 6 0 0
		wm_objective_status 6 1 0
		wm_objective_status 7 0 0
		wm_objective_status 7 1 0
		wm_objective_status 8 0 0
		wm_objective_status 8 1 0		
		
		wm_axis_respawntime 14
		wm_allied_respawntime 14
  		setautospawn "Allied Base" 1
		setautospawn "Old City Spawn" 0

		setstate allied_first_spawns_wobj default
		setstate allied_old_city_spawns_wobj invisible
		setstate allied_city2_spawns_wobj invisible
		setstate allied_garage_spawns_wobj invisible
		setstate allied_cave_spawns_wobj invisible		
		setstate axis_old_city_spawns_wobj default
		setstate axis_city2_spawns_wobj invisible
		setstate axis_garage_spawns_wobj invisible
		setstate axis_cave_spawns_wobj invisible
		setstate axis_temple2_spawns_wobj invisible
		setstate axis_temple1_spawns_wobj invisible

		setstate allied_first_spawns default		
		setstate allied_city_spawns invisible
		setstate allied_city2_spawns invisible
		setstate allied_garage_spawns invisible
		setstate allied_cave_spawns invisible		
		setstate axis_city_spawns default
		setstate axis_city2_spawns invisible
		setstate axis_garage_spawns invisible
		setstate axis_cave_spawns invisible
		setstate axis_temple2_spawns invisible
		setstate axis_temple1_spawns invisible
		
		wait 100
		setstate trigger_tst4 default
		setstate doorframe_damaged invisible
		setstate gateframe_damaged invisible
		setstate allies_citydoor_block default
		setstate axisdoor_flag default
		setstate fuelinfo default

		wait 800
		trigger stonelid downuphigh
		alertentity banana_trigger
		alertentity banana2_trigger
		alertentity banana3_trigger

		wm_announce "^8Map implements custom map script!"
		wm_announce "^8Allies get an extra spawn after delivering the key!"

	}

	trigger allies_stolen_key
	{
		trigger game_manager allies_stolen_key_allied_msg
		trigger game_manager allies_stolen_key_axis_msg
	}

	trigger allies_stolen_key_allied_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 1 "allies_stolen_key"
		wm_teamvoiceannounce 1 "allies_stolen_key"
		
		wm_removeteamvoiceannounce 1 "allies_steal_key"
		wm_removeteamvoiceannounce 1 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 1 "allies_stolen_key"
		// *---------------------------------------------------------------------------------*
	}

	trigger allies_stolen_key_axis_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "axis_stolen_key"
		wm_teamvoiceannounce 0 "axis_stolen_key"
		
		wm_removeteamvoiceannounce 0 "axis_protect_key"
		wm_removeteamvoiceannounce 0 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 0 "axis_stolen_key"
		// *---------------------------------------------------------------------------------*
	}

	trigger allies_stolen_fuel
	{
		trigger game_manager allies_stolen_fuel_allied_msg
		trigger game_manager allies_stolen_fuel_axis_msg
	}

	trigger allies_steal_fuel_allied_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "axis_protect_fuel"
		wm_addteamvoiceannounce 1 "allies_steal_fuel"
		wm_teamvoiceannounce 0 "axis_protect_fuel"
		wm_teamvoiceannounce 1 "allies_steal_fuel"
		
		wm_removeteamvoiceannounce 0 "axis_protect_fuel"
		wm_removeteamvoiceannounce 1 "allies_steal_fuel"
		// *---------------------------------------------------------------------------------*
	}
	
	trigger allies_stolen_fuel_allied_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 1 "allies_stolen_fuel"
		wm_teamvoiceannounce 1 "allies_stolen_fuel"
		
		wm_removeteamvoiceannounce 1 "allies_steal_fuel"
		wm_removeteamvoiceannounce 1 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 1 "allies_stolen_fuel"
		// *---------------------------------------------------------------------------------*
	}

	trigger allies_stolen_fuel_axis_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "axis_stolen_fuel"
		wm_teamvoiceannounce 0 "axis_stolen_fuel"
		
		wm_removeteamvoiceannounce 0 "axis_protect_fuel"
		wm_removeteamvoiceannounce 0 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 0 "axis_stolen_fuel"
		// *---------------------------------------------------------------------------------*
	}
	
	trigger allies_steal_tank
	{
		remapshader "sprites/objective" "sprites/objective"
		remapshaderflush
		
		wm_announce "^oAllied team has stolen the Tank!"

		trigger game_manager allies_steal_tank_allied_msg
		trigger game_manager allies_steal_tank_axis_msg
		trigger game_manager obj_lost_msg
	}

	trigger allies_steal_tank_allied_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_teamvoiceannounce 1 "goldrush_allies_tank_stolen"
		
		wm_removeteamvoiceannounce 1 "allies_stolen_fuel"
		wm_removeteamvoiceannounce 1 "allies_steal_fuel"
		wm_removeteamvoiceannounce 1 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 1 "goldrush_allies_tank_stolen"
		// *---------------------------------------------------------------------------------*
	}
	
	trigger allies_steal_tank_axis_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "goldrush_axis_tank_stolen"
		wm_teamvoiceannounce 0 "goldrush_axis_tank_stolen"
				
		wm_removeteamvoiceannounce 0 "axis_stolen_fuel"
		wm_removeteamvoiceannounce 0 "axis_protect_fuel"
		wm_removeteamvoiceannounce 0 "tank_fuel_lost"
		wm_removeteamvoiceannounce 0 "fueldump_axis_tunnel_destroyed"
		wm_removeteamvoiceannounce 0 "goldrush_axis_tank_stolen"
		// *---------------------------------------------------------------------------------*
	}

	trigger tank_fuel_cap_allied_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 1 "tank_fuel_cap"
		wm_teamvoiceannounce 1 "tank_fuel_cap"
		
		wm_removeteamvoiceannounce 1 "allies_stolen_fuel"
		wm_removeteamvoiceannounce 1 "allies_steal_fuel"
		wm_removeteamvoiceannounce 1 "tank_fuel_cap"
		wm_removeteamvoiceannounce 1 "fueldump_axis_tunnel_destroyed"
		// *---------------------------------------------------------------------------------*
	}
	
	trigger tank_fuel_cap_axis_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "tank_fuel_lost"
		wm_teamvoiceannounce 0 "tank_fuel_lost"
		
		wm_removeteamvoiceannounce 0 "allies_stolen_fuel"
		wm_removeteamvoiceannounce 0 "allies_steal_fuel"
		wm_removeteamvoiceannounce 0 "allies_secured_fuel"
		wm_removeteamvoiceannounce 0 "fueldump_allies_hq_gratedest"
		wm_removeteamvoiceannounce 0 "goldrush_axis_tank_stolen"
		// *---------------------------------------------------------------------------------*
	}

	trigger axis_stop_tank_msg
	{
		// *----------------------------------- vo ------------------------------------------*
		wm_addteamvoiceannounce 0 "axis_hq_tank_stop"
		wm_teamvoiceannounce 0 "axis_hq_tank_stop"

		wm_removeteamvoiceannounce 0 "axis_hq_tank_stop"
		// *---------------------------------------------------------------------------------*
	}
	
	trigger func_explosive_generator_dynamited
	{
		wait 2500
		wm_teamvoiceannounce 0 "axis_goodgame"		
		wm_teamvoiceannounce 1 "allies_goodgame"		
		trigger game_manager endgame
	}
	
	trigger endgame
	{
		wm_setwinner 1
		wait 6000
		wm_endround
		wait 6000
		trigger tube tube_flip
	}
}

func_explosive_generator
{
	spawn
	{
		wait 50
		constructible_class 3
	}

	death
	{
		wm_announce "^oAncient Anti-Gravity Generator destroyed!"
		wm_teamvoiceannounce 0 "battery_axis_generator_destroyed"
		wm_teamvoiceannounce 1 "battery_allies_generator_destroyed"
		disablespeaker generator
		trigger generatorwater up
		trigger stonelid upper
		trigger game_manager func_explosive_generator_dynamited
	}	
}

tube
{
	spawn
	{
	}
	trigger tube_flip
	{
		alertentity tube_explosion
		playsound sound/maps/expl_med.wav
		wait 600
		faceangles -270 1 0 600
		playsound sound/world/metalbreak.wav
		wait 600
		playsound sound/maps/expl_small.wav
	}	
}

/// =========FLAG===============
oldcityflag
{
	spawn
	{
		accum 0 set 0	// Who has the flag: 0-Axis, 1-Allied, 2-Nobody
	}

	trigger axis_capture	// Flag has been touched by an Axis player
	{
		accum 0 abort_if_equal 0	// do Axis own flag?
		accum 0 set 0	// Axis own the pole

		wm_objective_status 7 0 1
		wm_objective_status 7 1 2

		setstate allied_first_spawns_wobj default
		setstate allied_old_city_spawns_wobj invisible
		setstate axis_old_city_spawns_wobj default
		setstate axis_garage_spawns_wobj invisible
///		setstate axis_city2_spawns_wobj invisible

		setstate allied_first_spawns default		
		setstate allied_city_spawns invisible
		setstate axis_city_spawns default		
		setstate axis_garage_spawns invisible
		setstate axis_city2_spawns invisible
		
		setautospawn "Allied Base"	1
		setautospawn "Old City Spawn"	0
		
		wm_announce "^oAxis reclaim the Old City!"
		
		wm_teamvoiceannounce 0 "oasis_axis_city_captured"
		wm_teamvoiceannounce 1 "oasis_allies_city_lost"	
	}

	trigger allied_capture	// Flag has been touched by an allied player
	{
		accum 0 abort_if_equal 1	// do Allies own flag?
		accum 0 set 1	// Allied own the flag

		wm_objective_status 7 0 2
		wm_objective_status 7 1 1

		setstate allied_old_city_spawns_wobj default
		setstate allied_first_spawns_wobj invisible
		setstate axis_old_city_spawns_wobj invisible
		setstate axis_garage_spawns_wobj default
///		setstate axis_city2_spawns_wobj default

		setstate allied_first_spawns invisible
		setstate allied_city_spawns default
		setstate axis_city_spawns invisible		
		setstate axis_garage_spawns default
		setstate axis_city2_spawns default

		setautospawn "Old City Spawn"	1		
		setautospawn "Garage Spawn"		0
		setautospawn "City Spawn"		0
		
		wm_announce "^oAllies capture the Old City!"
		
		wm_teamvoiceannounce 0 "oasis_axis_city_lost"
		wm_teamvoiceannounce 1 "oasis_allies_city_captured"
	}
	
	trigger check_obj
	{
		accum 0 abort_if_equal 1 // Do Allied own the flag?
		
		wm_objective_status 		7 0 2
		wm_objective_status 		7 1 1
	}
	
	trigger force_allied
	{
		accum 0 abort_if_equal 1 // Do Allied own the flag?

		setstate allied_first_spawns_wobj invisible
		setstate allied_old_city_spawns_wobj default		
		setstate allied_garage_spawns_wobj invisible		
		setstate axis_old_city_spawns_wobj invisible
		setstate axis_garage_spawns_wobj default
///		setstate axis_city2_spawns_wobj invisible
		setstate axis_cave_spawns_wobj invisible		
		
		setstate allied_first_spawns invisible
		setstate allied_city_spawns default		
		setstate allied_garage_spawns invisible
		setstate axis_city_spawns invisible
		setstate axis_garage_spawns default
		setstate axis_city2_spawns invisible
		setstate axis_cave_spawns invisible
	}
		
	trigger kill
	{
		disablespeaker flagsound
		remove
	}	
}

/// =========FLAG2===============
city2flag
{
	spawn
	{
		accum 6 set 0	// Who has the flag: 0-Axis, 1-Allied, 2-Nobody
	}

	trigger axis_capture	// Flag has been touched by an Axis player
	{
		accum 6 abort_if_equal 0	// do Axis own flag?
		accum 6 set 0	// Axis own the pole

///		setstate allied_city2_spawns_wobj invisible
		setstate allied_city2_spawns invisible
		
		setautospawn "Old City Spawn" 1
		
		wm_announce "^oAxis reclaim the City!"
		
///		wm_teamvoiceannounce 0 "oasis_axis_city_captured"
///		wm_teamvoiceannounce 1 "oasis_allies_city_lost"	
	}

	trigger allied_capture	// Flag has been touched by an allied player
	{
		accum 6 abort_if_equal 1	// do Allies own flag?
		accum 6 set 1	// Allied own the flag

///		setstate allied_city2_spawns_wobj default
		setstate allied_city2_spawns default

		setautospawn "Old City Spawn"	1		
		setautospawn "City Spawn"		1
		
		wm_announce "^oAllies capture the City!"
		
///		wm_teamvoiceannounce 0 "oasis_axis_city_lost"
///		wm_teamvoiceannounce 1 "oasis_allies_city_captured"
	}
	
	trigger check_obj
	{
		accum 6 abort_if_equal 1 // Do Allied own the flag?
		
	}
	
	trigger force_allied
	{
		accum 6 abort_if_equal 1 // Do Allied own the flag?

	}
		
	trigger kill
	{
		disablespeaker flag2sound
		remove
	}	
}

/// ========KEY=============
axis_key
{
	spawn
	{
		wait 200
		setstate axis_key_captured2 invisible
	}

	trigger stolen
	{
		wm_announce "^oThe Allies have stolen the Key!"

		setstate axis_key_cm_marker invisible
		setstate axis_key_toi invisible

		wm_objective_status 5 0 2
		wm_objective_status 5 1 0
		
		trigger game_manager allies_stolen_key_allied_msg
		trigger game_manager allies_stolen_key_axis_msg
	}

	trigger returned
	{
		setstate axis_key_cm_marker default
		setstate axis_key_toi default

		wm_announce "^oThe Axis have intercepted the stolen Key."
		
		wm_objective_status 5 0 1
		wm_objective_status 5 1 2
	}

	trigger captured
	{
		setstate allied_lock_cm_marker invisible
		trigger stonedoor open
		trigger stonelid open		

		wm_announce "^oThe Allies have secured the Key to open the door."

		// extra stuff
		setstate temple_marker default
		setstate temple_spawn default
		setstate afp_marker default
		setautospawn "Temple" 1
		setautospawn "Cave Spawn" 0
		setstate allied_cave_spawns_wobj invisible



		wm_objective_status 5 0 2
		wm_objective_status 5 1 1

		wm_teamvoiceannounce 0 "axis_hq_objective_lost"
		wm_teamvoiceannounce 1 "key_cap"

		wait 6000
		wm_teamvoiceannounce 0 "battery_axis_generator_defend"
		wm_teamvoiceannounce 1 "battery_allies_generator_destroy"		

		remapshader "sprites/objective" "sprites/objective"
		remapshaderflush
	}
	
	trigger dropped
	{
		wm_announce "^oThe key has been dropped."
	}
}

keybed_trigger2
{
	spawn
	{
	}

	death
	{
		setstate axis_key_red2 invisible
		setstate axis_key_captured2 default

		remove
	}
}

