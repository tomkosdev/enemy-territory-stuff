// ********************************************************************
// * sk8                                                      *
// ********************************************************************
sk8trigger
{
	spawn
	{
		wait 500
	}
	trigger start_sk8
	{
		trigger sk8 go
	}
}

sk8
{
	trigger go
	{
		setstate sk8tr invisible
		playsound sound/movers/misc/big_gate2.wav looping volume 400
		gotomarker sk8_right_pc2a 200 wait
		gotomarker sk8_right_pc1a 380 wait
		gotomarker sk8_right_pc1 200 wait
		stopsound
		wait 1000
		setstate sk8trback default
	}
	
	trigger goback
	{
		setstate sk8trback invisible
		playsound sound/movers/misc/big_gate2.wav looping volume 400
		gotomarker sk8_right_pc1a 200 wait
		gotomarker sk8_right_pc2a 380 wait
		gotomarker sk8_right_pc2 200 wait
		stopsound
		wait 1000
		setstate sk8tr default
	}
}

sk8triggerback
{
	spawn
	{
		wait 500
		setstate sk8trback invisible
	}
	
	trigger start_sk8back
	{
		trigger sk8 goback
	}
}
