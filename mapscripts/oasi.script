allied_destructible_maingate
{
	spawn
	{
		wait 300
		constructible_class 3 // 2=satchel  3=dyna
		
		wm_objective_status 		1 0 1
		wm_objective_status 		1 1 2
		
		setstate alldoor_flag invisible
	}

	death
	{
		trigger allied_destructible_maingate_done remove
		setstate gateframe_damaged default
		setstate axisdoor_flag invisible
		setstate alldoor_flag default
		setstate allies_citydoor_block invisible		
		trigger alldoor_flag door_flip
		
		wm_objective_status 		1 0 2
		wm_objective_status 		1 1 1		

		trigger oldcityflag force_allied  ///// Switch forward spawn to Allied ONLY
		trigger oldcityflag check_obj		
		trigger oldcityflag kill

///		setstate axis_city2_spawns_wobj invisible
		setstate axis_city2_spawns invisible
		
		setautospawn "Old City Spawn"	1		
		setautospawn "Garage Spawn"		0
		
		wm_teamvoiceannounce 0 "radar_axis_entrance1_destroyed"		
		wm_teamvoiceannounce 1 "radar_allies_entrance1_destroyed"

		wm_announce "^oThe Allies have destroyed the Main Gate!"
		
		trigger game_manager allies_steal_fuel_allied_msg
	}
}

