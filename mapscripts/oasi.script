	spawn
	{
	}

	trigger up
	{
		wait 100
		gotomarker waterup_right_pc1 6 wait
	}
}

////////////////////////////////////////////////////////////////////////
////////////////////////////////STONE DOOR
stonedoor
{
	spawn
	{
	}

	trigger open
	{
		wait 300
		playsound sound/movers/misc/big_gate2.wav looping volume 427
		gotomarker stonedoor_right_pc2 8 wait
		stopsound
		playsound sound/movers/misc/big_gate3.wav volume 227
	}
}

////////////////////////////////////////////////////////////////////////
////////////////////////////////STONE LID
stonelid
{
	spawn
	{
		wait 50
	}

	trigger close
	{
		wait 300
		gotomarker stonelid_right_pc1 14 wait
	}
	
	trigger open
	{
		playsound sound/maps/track_move.wav volume 427
		wait 800
		alertentity lid_smoke
		playsound sound/weapons/browning/browning_heat.wav volume 427		
		gotomarker stonelid_right_pc2 8 wait
		wait 100
		alertentity lid_smoke
		trigger self downup
	}
	
	trigger downup
	{
		wait 100
		gotomarker stonelid_right_pc3 4 wait
		wait 100
		gotomarker stonelid_right_pc2 4 wait
		trigger self downup
	}
	
	trigger downuphigh
	{
		wait 100
		gotomarker stonelid_right_pc5 14 wait
		wait 100
		gotomarker stonelid_right_pc2 14 wait
		trigger self downuphigh
	}
	
	trigger upper
	{
		wait 100
		gotomarker stonelid_right_pc4 60 wait
	}
}

