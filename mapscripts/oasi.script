/// =============================================================================
/// === Barrier 0 Mapscript
/// =============================================================================
defense0
{
	spawn
	{
		wait 400
		setstate defense0_materials invisible
		setstate defense0_materials_clip invisible
		setstate defense0_flag invisible
		constructible_class 3
		constructible_chargebarreq 1.0
		constructible_constructxpbonus 10
		constructible_destructxpbonus 10
	}
	
	buildstart final
	{
		setstate defense0_materials default
		setstate defense0_materials_clip default
		setstate defense0_flag default
	}
	
	built final
	{
		setstate defense0_materials invisible
		setstate defense0_materials_clip invisible
		setstate defense0_flag invisible
		//inform the tank that this barricade has been built
		trigger tank barricade0_constructed
		wm_announce "^oThe first Tank Barrier has been constructed."
		wm_teamvoiceannounce 0 "goldrush_axis_tankbar_constructed"
		wm_teamvoiceannounce 1 "goldrush_allies_tankbars_destroy"		
	}
	
	decayed final
	{
		setstate defense0_materials default
		setstate defense0_materials_clip default
		setstate defense0_flag default
	}
	
	death
	{
		setstate defense0_materials default
		setstate defense0_materials_clip default
		setstate defense0_flag default
		trigger tank barricade0_destroyed
		wm_announce "^oAllies team has destroyed the first Tank Barrier!"
		wm_teamvoiceannounce 0 "goldrush_axis_tankbars_construct"		
		wm_teamvoiceannounce 1 "goldrush_allies_tankbar_destroyed"
	}
	
	trigger remove
	{
		setstate defense0_toi invisible
		setstate defense0_materials invisible
		setstate defense0_materials_clip invisible
		setstate defense0_flag invisible
		remove
	}
}

/// =============================================================================
