/// *********************************************************************
/// Switch to turn on/off the tap
/// *********************************************************************
tap_trigger1
{
	spawn
	{
		accum 9 set 1			// Initial state is down
		wait 500			// Wait for everything to settle
		trigger tap_trigger1 main	// Open front door of complex initially
	}
	
	trigger main
	{
		globalaccum 5 abort_if_not_equal 0
		trigger tap_trigger1 up
		trigger tap_trigger1 down

	}
	
	trigger up
	{
			accum 9 abort_if_not_equal 1	// Ready to run up routine == 1
			resetscript			// return to trigger that called it

			trigger tap_lever1 up
			accum 9 set 0			// Setup accum for up routine
	}
	
	trigger down
	{
			accum 9 abort_if_not_equal 0	// Ready to run down routine == 0
			resetscript			// return to trigger that called it

			trigger tap_lever1 down
			accum 9 set 1			// Setup accum for up routine
	}
}

tap_lever1
{
	spawn
	{
	}
	
	trigger down
	{
		setstate tapwater invisible
		stopsound	
	}
	
	trigger up
	{
		setstate tapwater default	
		playsound sound/world/steam_01.wav looping volume 80
///		///// automatically stop
///		wait 4500
///		trigger tap_trigger1 down
	}
}

