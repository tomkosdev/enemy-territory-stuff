// ************************************
/// *******************
/// **** Barricade BACKGATE/Side Entrance ****
/// *******************
const2_te
{
	spawn
	{
		wait 200
		trigger const2_te setup
		constructible_class 2 // 2=satchel  3=dyna
		constructible_chargebarreq 1.5
		wm_objective_status 		8 0 1
		wm_objective_status 		8 1 2		
	}

	trigger setup
	{
		setstate const2_te default
		setstate te_materials2 invisible
		setstate te_materials2_clip invisible
		setstate te_flag2 invisible
		wm_objective_status 		8 0 1
		wm_objective_status 		8 1 2
	}

	buildstart final
	{
		setstate const2_te underconstruction
		setstate te_materials2 default
		setstate te_materials2_clip default
		setstate te_flag2 default
	}

	built final
	{
		setstate const2_te default
		setstate te_materials2 invisible
		setstate te_materials2_clip invisible
		setstate te_flag2 invisible
		wm_announce "^oThe Side Entrance has been built."	
		wm_objective_status 		8 0 1
		wm_objective_status 		8 1 2
		
///		wm_teamvoiceannounce 0 "radar_axis_entrance2_defend"
		wm_teamvoiceannounce 1 "radar_allies_entrance2_destroy"	
	}

	decayed final
	{
		setstate const2_te invisible
		setstate te_materials2 default
		setstate te_materials2_clip default
		setstate te_flag2 default
	}

	death
	{
		setstate const2_te invisible
		setstate te_materials2 default
		setstate te_materials2_clip default
		setstate te_flag2 default
		
		wm_objective_status 		8 0 2
		wm_objective_status 		8 1 1

		wm_announce "^oAllies have breached the Side Entrance!"	
		wm_teamvoiceannounce 0 "radar_axis_entrance2_destroyed"
///		wm_teamvoiceannounce 1 "radar_allies_entrance2_destroyed"		
	}
}

