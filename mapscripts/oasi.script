		wait 3400
		trigger tank sound_idle
	}
}
//
// digibob: converting truck script from goldrush over...
// ============================================================================
// accum 0, track state
// accum 1
//  - bit 0: barrier1 state		( 0 = not built,	1 = built		)
//  - bit 1: barrier2 state		( 0 = not built,	1 = built		)
//  - bit 2: spline status 		( 0 = not moving, 	1 = moving 		)
//  - bit 3: stuck check flag 	( 0 = not stuck, 	1 = stuck 		)
//  - bit 4: flag for message	( 0 = dont display, 1= display		)
//  - bit 5: blank				(									)
//  - bit 6: temp register 		(XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
//  - bit 7: death status 		( 0 = alive, 		1 = dead		)
//  - bit 8: player check 		( 0 = players, 		1 = no players	)
//  - bit 9: visible state		( 0 = alive, 		1 = dead		)
// accum 2, blank
// accum 3, current movement loop position
// accum 4, stop counter
// accum 5, lockout ref counter
// accum 6, blank
// accum 7, blank
// ===========================================================================================
// spline points are path_2 -> path_78
// ===========================================================================================
// track events:
//  - tracks_forward
//  - tracks_stop
//  - tracks_turn_left
//  - tracks_turn_right

tank
{
	spawn
	{
		wait 400
		constructible_chargebarreq 1.0
		constructible_constructxpbonus 10
		constructible_destructxpbonus 10
		
		followspline 0 path_0 150000 wait length -64

		trigger self sound_idle
		trigger self tracks_stop
		trigger self barricade1_constructed
		trigger self barricade0_constructed		
	}

	// ========================================
	// sound stuff

	trigger sound_idle
	{
		stopsound
		playsound sound/vehicles/tank/tank_idle.wav looping volume 512
	}

	trigger sound_start
	{
		stopsound
		playsound sound/vehicles/tank/tank_revup.wav volume 196
	}

	trigger sound_move
	{
		stopsound
		playsound sound/vehicles/tank/tank_move.wav looping volume 512
	}

	trigger sound_stop
	{
		stopsound
		playsound sound/vehicles/tank/tank_revdown.wav volume 196
	}

	trigger sound_death
	{
		stopsound
		playsound sound/vehicles/tank/tank_stop.wav volume 256
	}

	trigger sound_rebirth
	{
		stopsound
		playsound sound/vehicles/tank/tank_start.wav volume 196
	}

// ===========================================================================================
// ===========================================================================================
	trigger tracks_forward
	{
		accum 0 abort_if_equal 1
		accum 0 set 1

		remapshader models/mapobjects/tanks_sd/jag_tracks_left 	models/mapobjects/tanks_sd/jag_tracks_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_tracks_right models/mapobjects/tanks_sd/jag_tracks_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_wheels_left 	models/mapobjects/tanks_sd/jag_wheels_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_wheels_right models/mapobjects/tanks_sd/jag_wheels_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_cogs_left 	models/mapobjects/tanks_sd/jag_cogs_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_cogs_right 	models/mapobjects/tanks_sd/jag_cogs_alt_forward

		remapshaderflush
	}

	trigger tracks_stop
	{
		accum 0 abort_if_equal 0
		accum 0 set 0

		remapshader models/mapobjects/tanks_sd/jag_tracks_left 	models/mapobjects/tanks_sd/jag_tracks_left
		remapshader models/mapobjects/tanks_sd/jag_tracks_right models/mapobjects/tanks_sd/jag_tracks_right
		remapshader models/mapobjects/tanks_sd/jag_wheels_left 	models/mapobjects/tanks_sd/jag_wheels_left
		remapshader models/mapobjects/tanks_sd/jag_wheels_right models/mapobjects/tanks_sd/jag_wheels_right
		remapshader models/mapobjects/tanks_sd/jag_cogs_left 	models/mapobjects/tanks_sd/jag_cogs_left
		remapshader models/mapobjects/tanks_sd/jag_cogs_right 	models/mapobjects/tanks_sd/jag_cogs_right

		remapshaderflush
	}

	trigger tracks_turn_left
	{
		accum 0 abort_if_equal 2
		accum 0 set 2

		remapshader models/mapobjects/tanks_sd/jag_tracks_left 	models/mapobjects/tanks_sd/jag_tracks_alt_backward
		remapshader models/mapobjects/tanks_sd/jag_tracks_right models/mapobjects/tanks_sd/jag_tracks_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_wheels_left 	models/mapobjects/tanks_sd/jag_wheels_alt_backward
		remapshader models/mapobjects/tanks_sd/jag_wheels_right models/mapobjects/tanks_sd/jag_wheels_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_cogs_left 	models/mapobjects/tanks_sd/jag_cogs_alt_backward
		remapshader models/mapobjects/tanks_sd/jag_cogs_right 	models/mapobjects/tanks_sd/jag_cogs_alt_forward

		remapshaderflush
	}

	trigger tracks_turn_right
	{
		accum 0 abort_if_equal 3
		accum 0 set 3

		remapshader models/mapobjects/tanks_sd/jag_tracks_left 	models/mapobjects/tanks_sd/jag_tracks_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_tracks_right models/mapobjects/tanks_sd/jag_tracks_alt_backward
		remapshader models/mapobjects/tanks_sd/jag_wheels_left 	models/mapobjects/tanks_sd/jag_wheels_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_wheels_right models/mapobjects/tanks_sd/jag_wheels_alt_backward
		remapshader models/mapobjects/tanks_sd/jag_cogs_left 	models/mapobjects/tanks_sd/jag_cogs_alt_forward
		remapshader models/mapobjects/tanks_sd/jag_cogs_right 	models/mapobjects/tanks_sd/jag_cogs_alt_backward

		remapshaderflush
	}

// ===========================================================================================
// ===========================================================================================

	trigger run_continue
	{
		accum 3 inc 1
		trigger self deathcheck
		trigger self stopcheck
		trigger self move
	}


// ===========================================================================================
// movement

	trigger move_check
	{
		trigger self stuck_check
		accum 1 abort_if_bitset 3

		trigger self dispatch
	}

	trigger move
	{
		trigger self move_check

		wait 500

		trigger self move
	}

	trigger dispatch
	{
		accum 3 trigger_if_equal 0 tank move_to_0
		accum 3 trigger_if_equal 1 tank move_to_1
		accum 3 trigger_if_equal 2 tank move_to_2
		accum 3 trigger_if_equal 3 tank move_to_3
		accum 3 trigger_if_equal 4 tank move_to_4
		accum 3 trigger_if_equal 5 tank move_to_5
		accum 3 trigger_if_equal 6 tank move_to_6
		accum 3 trigger_if_equal 7 tank move_to_7
		accum 3 trigger_if_equal 8 tank move_to_8
		accum 3 trigger_if_equal 9 tank move_to_9
		accum 3 trigger_if_equal 10 tank move_to_10
		accum 3 trigger_if_equal 11 tank move_to_11
		accum 3 trigger_if_equal 12 tank move_to_12
		accum 3 trigger_if_equal 13 tank move_to_13
		accum 3 trigger_if_equal 14 tank move_to_14
		accum 3 trigger_if_equal 15 tank move_to_15
		accum 3 trigger_if_equal 16 tank move_to_16
		accum 3 trigger_if_equal 17 tank move_to_17
		accum 3 trigger_if_equal 18 tank move_to_18
		accum 3 trigger_if_equal 19 tank move_to_19
		accum 3 trigger_if_equal 20 tank move_to_20
		accum 3 trigger_if_equal 21 tank move_to_21
		accum 3 trigger_if_equal 22 tank move_to_22
		accum 3 trigger_if_equal 23 tank move_to_23
		accum 3 trigger_if_equal 24 tank move_to_24
		accum 3 trigger_if_equal 25 tank move_to_25
		accum 3 trigger_if_equal 26 tank move_to_26
		accum 3 trigger_if_equal 27 tank move_to_27
		accum 3 trigger_if_equal 28 tank move_to_28
		accum 3 trigger_if_equal 29 tank move_to_29
		accum 3 trigger_if_equal 30 tank move_to_30
		accum 3 trigger_if_equal 31 tank move_to_31
		accum 3 trigger_if_equal 32 tank move_to_32
		accum 3 trigger_if_equal 33 tank move_to_33
		accum 3 trigger_if_equal 34 tank move_to_34
		accum 3 trigger_if_equal 35 tank move_to_35
		accum 3 trigger_if_equal 36 tank move_to_36
		accum 3 trigger_if_equal 37 tank move_to_37
		accum 3 trigger_if_equal 38 tank move_to_38
		accum 3 trigger_if_equal 39 tank move_to_39
		accum 3 trigger_if_equal 40 tank move_to_40
		accum 3 trigger_if_equal 41 tank move_to_41
		accum 3 trigger_if_equal 42 tank move_to_42
		accum 3 trigger_if_equal 43 tank move_to_43
		accum 3 trigger_if_equal 44 tank move_to_44
		accum 3 trigger_if_equal 45 tank move_to_45
		accum 3 trigger_if_equal 46 tank move_to_46
		accum 3 trigger_if_equal 47 tank move_to_47
		accum 3 trigger_if_equal 48 tank move_to_48
		accum 3 trigger_if_equal 49 tank move_to_49
		accum 3 trigger_if_equal 50 tank move_to_50
		accum 3 trigger_if_equal 51 tank move_to_51
		accum 3 trigger_if_equal 52 tank move_to_52
		accum 3 trigger_if_equal 53 tank move_to_53
		accum 3 trigger_if_equal 54 tank move_to_54
		accum 3 trigger_if_equal 55 tank move_to_55	
		accum 3 trigger_if_equal 56 tank move_to_56
		accum 3 trigger_if_equal 57 tank move_to_57
		accum 3 trigger_if_equal 58 tank move_to_58
		accum 3 trigger_if_equal 59 tank move_to_59
		accum 3 trigger_if_equal 60 tank move_to_60		
	}

	trigger move_to_0
	{
		trigger self run_continue
	}

	trigger move_to_1
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_0 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_2
	{
		trigger self tracks_forward
		trigger game_manager allies_steal_tank		

		accum 1 bitset 2
		followspline 0 path_1 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_3
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_2 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_4
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_3 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_5
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_4 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_6
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_5 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_7
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_6 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_8
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_7 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_9
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_8 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_10
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_9 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_11
	{
		trigger gate_left gate_flip
		trigger gate_right gate_flip
			
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_10 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_12
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_11 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_13
	{
		trigger self tracks_turn_right

		accum 1 bitset 2
		followspline 0 path_12 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
	}

	trigger move_to_14
	{
		trigger self tracks_forward

		accum 1 bitset 2
		followspline 0 path_13 100 wait length -64
		accum 1 bitreset 2

		trigger self run_continue
